# Generate a development key in the Amazon Bedrock console for us-east-1.
AWS_BEARER_TOKEN_BEDROCK=replace-with-your-bedrock-api-key
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
PORT=8787
# The hosted Lambda uses BEDROCK_AUTH_MODE=iam with an execution role.
# See deploy/serverless/README.md for public deployment variables.
